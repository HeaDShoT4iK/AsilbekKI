      "source": [
        "# 4. Plotting Training vs Validation Accuracy and Loss\n",
        "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(15, 5))\n",
        "\n",
        "for act in activations:\n",
        "    # Accuracy plot\n",
        "    ax1.plot(histories[act].history['accuracy'], label=f'{act} (train)')\n",
        "    ax1.plot(histories[act].history['val_accuracy'], label=f'{act} (val)', linestyle='--')\n",
        "\n",
        "    # Loss plot\n",
        "    ax2.plot(histories[act].history['loss'], label=f'{act} (train)')\n",
        "    ax2.plot(histories[act].history['val_loss'], label=f'{act} (val)', linestyle='--')\n",
        "\n",
        "ax1.set_title('Training vs Validation Accuracy')\n",
        "ax1.set_xlabel('Epoch')\n",
        "ax1.set_ylabel('Accuracy')\n",
        "ax1.legend()\n",
        "\n",
        "ax2.set_title('Training vs Validation Loss')\n",
        "ax2.set_xlabel('Epoch')\n",
        "ax2.set_ylabel('Loss')\n",
        "ax2.legend()\n",
        "\n",
        "plt.show()"
      ],
