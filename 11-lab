    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "9aefaa9e",
        "outputId": "53842fb9-708e-41fd-c060-272581544af7"
      },
      "source": [
        "def build_model(activation_fn):\n",
        "    \"\"\"Creates a Sequential model with a specific activation function.\"\"\"\n",
        "    model = models.Sequential([\n",
        "        layers.Flatten(input_shape=(28, 28)),\n",
        "        layers.Dense(128, activation=activation_fn),\n",
        "        layers.Dense(64, activation=activation_fn),\n",
        "        layers.Dense(10, activation='softmax')\n",
        "    ])\n",
        "    model.compile(optimizer='adam',\n",
        "                  loss='sparse_categorical_crossentropy',\n",
        "                  metrics=['accuracy'])\n",
        "    return model\n",
        "\n",
        "# 2. Creating models\n",
        "activations = ['sigmoid', 'relu', 'tanh']\n",
        "histories = {}\n",
        "models_dict = {}\n",
        "\n",
        "# 3. Training models for 5 epochs\n",
        "for act in activations:\n",
        "    print(f\"\\nTraining model with {act} activation...\")\n",
        "    model = build_model(act)\n",
        "    history = model.fit(x_train, y_train, epochs=5, validation_split=0.1, verbose=1)\n",
        "    histories[act] = history\n",
        "    models_dict[act] = model"
      ],
